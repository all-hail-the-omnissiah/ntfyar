{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ntfyar",
  "identifier": "app.ntfyar.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ntfyar",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Desktop client for ntfy",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
